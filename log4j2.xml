<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <!-- コンソール: UTF-8 -->
    <Console name="Console" target="SYSTEM_OUT" charset="UTF-8">
      <PatternLayout charset="UTF-8"
        pattern="[%d{yyyy-MM-dd HH:mm:ss}: %highlight{%p}] %msg%n"/>
      <!-- ここで抑制 -->
      <RegexFilter regex=".*(Summoned new|Applied effect).*" onMatch="DENY" onMismatch="NEUTRAL"/>
    </Console>

    <!-- ファイル: UTF-8（必要なら） -->
    <File name="ServerFile" fileName="logs/latest-utf8.log" append="true">
      <PatternLayout charset="UTF-8"
        pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%t/%level]: %msg%n"/>
    </File>
  </Appenders>

  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
      <!-- 併用するなら -->
      <!-- <AppenderRef ref="ServerFile"/> -->
    </Root>
  </Loggers>
</Configuration>
